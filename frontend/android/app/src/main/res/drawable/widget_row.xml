<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_disabled" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_paper" />
            <stroke android:width="@dimen/widget_stroke" android:color="@color/widget_divider" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
            <corners android:radius="7dp" />
        </shape>
    </item>
</layer-list>
