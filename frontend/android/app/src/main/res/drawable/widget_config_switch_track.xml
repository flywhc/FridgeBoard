<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="48dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/widget_config_switch_track_shadow" />
        </shape>
    </item>
    <item android:left="1dp" android:top="0dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp" />
            <solid android:color="@color/widget_config_switch_track" />
            <stroke android:width="1dp" android:color="@color/widget_config_switch_track_highlight" />
        </shape>
    </item>
</layer-list>
