<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="@color/widget_paper" /><stroke android:width="1dp" android:color="@color/widget_disabled" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp" android:left="1dp" android:right="-1dp" android:bottom="-1dp">
                <shape android:shape="oval"><solid android:color="@color/widget_divider" /></shape>
            </item>
            <item>
                <shape android:shape="oval"><solid android:color="@color/widget_surface" /><stroke android:width="1dp" android:color="@color/widget_ink" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/widget_surface" />
            <stroke android:width="1dp" android:color="@color/widget_divider" />
        </shape>
    </item>
</selector>
