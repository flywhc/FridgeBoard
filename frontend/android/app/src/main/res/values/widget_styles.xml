<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetDayBadge">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@drawable/widget_day_badge</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">@dimen/widget_caption_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetHiddenDate">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="WidgetRecipeName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">@dimen/widget_body_size</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetRecipeIngredients">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">@dimen/widget_caption_size</item>
    </style>
    <style name="WidgetPotButton">
        <item name="android:layout_width">@dimen/widget_touch_size</item>
        <item name="android:layout_height">@dimen/widget_touch_size</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:contentDescription">@string/widget_mark_done</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:src">@drawable/widget_pot</item>
    </style>
    <style name="WidgetPageDot">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:contentDescription">@string/widget_page_dot</item>
        <item name="android:padding">4dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:src">@drawable/widget_page_dot</item>
    </style>
    <style name="WidgetConfigSecondaryButton">
        <item name="android:background">@drawable/widget_config_button_secondary</item>
        <item name="android:minHeight">@dimen/widget_config_button_height</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="WidgetConfigPrimaryButton">
        <item name="android:background">@drawable/widget_config_button_primary</item>
        <item name="android:minHeight">@dimen/widget_config_button_height</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">20dp</item>
        <item name="android:paddingRight">20dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
