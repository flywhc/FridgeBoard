<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_title_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_title_size"
            android:textStyle="bold" />
        <TextView
            android:layout_width="@dimen/widget_status_width"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:text="家常冰箱"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_caption_size" />
        <ImageView
            android:layout_width="@dimen/widget_touch_size"
            android:layout_height="@dimen/widget_touch_size"
            android:layout_gravity="end"
            android:contentDescription="@string/widget_refresh"
            android:padding="12dp"
            android:src="@drawable/widget_refresh"
            android:translationX="@dimen/widget_header_action_shift_x"
            android:translationY="@dimen/widget_header_action_shift_y" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_narrow_row_height"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView style="@style/WidgetDayBadge" android:text="周一" />
            <TextView
                style="@style/WidgetRecipeName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="番茄炒蛋" />
            <ImageView
                android:layout_width="@dimen/widget_touch_size"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_mark_done"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/widget_pot" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_narrow_row_height"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView style="@style/WidgetDayBadge" android:text="周二" />
            <TextView
                style="@style/WidgetRecipeName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="香菇鸡丁" />
            <ImageView
                android:layout_width="@dimen/widget_touch_size"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_mark_done"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/widget_pot" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_narrow_row_height"
            android:background="@drawable/widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <TextView style="@style/WidgetDayBadge" android:text="周三" />
            <TextView
                style="@style/WidgetRecipeName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:maxLines="1"
                android:text="清蒸鲈鱼"
                android:textColor="@color/widget_done" />
            <ImageView
                android:layout_width="@dimen/widget_touch_size"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_done"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/widget_pot_done" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_footer_height"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="本周完成 1/3"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="33"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</LinearLayout>
