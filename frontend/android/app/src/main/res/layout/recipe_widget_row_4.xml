<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_4"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_row_height"
    android:background="@drawable/widget_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp">
    <TextView android:id="@+id/widget_row_4_day" style="@style/WidgetDayBadge" />
    <TextView android:id="@+id/widget_row_4_date" style="@style/WidgetHiddenDate" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical"
        android:paddingStart="4dp">
        <TextView android:id="@+id/widget_row_4_recipe" style="@style/WidgetRecipeName" />
        <TextView android:id="@+id/widget_row_4_ingredients" style="@style/WidgetRecipeIngredients" />
    </LinearLayout>
    <ImageButton android:id="@+id/widget_row_4_toggle" style="@style/WidgetPotButton"
        android:layout_marginEnd="@dimen/widget_pot_end_compensation" />
</LinearLayout>
