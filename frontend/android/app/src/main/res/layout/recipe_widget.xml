<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_panel"
    android:clipChildren="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_title_height"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_ink"
            android:textSize="@dimen/widget_title_size"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="@dimen/widget_status_width"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_caption_size" />
        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="@dimen/widget_touch_size"
            android:layout_height="@dimen/widget_touch_size"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_refresh"
            android:padding="@dimen/widget_refresh_padding"
            android:src="@drawable/widget_refresh"
            android:translationX="@dimen/widget_header_action_shift_x"
            android:translationY="@dimen/widget_header_action_shift_y" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_page_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        android:layout_weight="1">
        <ListView
            android:id="@+id/widget_page_stack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:fadingEdge="none"
            android:fadingEdgeLength="0dp"
            android:overScrollMode="never"
            android:scrollbars="vertical"
            android:scrollbarThumbVertical="@drawable/widget_scrollbar_thumb"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideInset"
            android:verticalScrollbarPosition="right"
            android:fadeScrollbars="false"
            android:scrollingCache="false" />
        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/widget_muted"
            android:textSize="@dimen/widget_body_size"
            android:text="@string/widget_empty_week"
            android:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_footer_height"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/widget_progress_label"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />
        <ProgressBar
            android:id="@+id/widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</LinearLayout>
