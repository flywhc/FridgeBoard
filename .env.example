# 生产环境持久卷中的 SQLite 数据库路径；请使用容器内绝对路径。
FRIDGEBOARD_DATABASE_URL=sqlite:////data/fridgeboard.db
# 生产环境图标资产和 Thiings 目录缓存必须位于持久卷。
FRIDGEBOARD_ICON_ASSET_DIR=/data/fridgeboard-icons
FRIDGEBOARD_PUBLIC_BASE_URL=https://fridge.flycn.fyi
# App Links/Universal Links 关联信息；只填正式签名指纹和 Apple Team ID。
# 多个 Android 指纹用英文逗号分隔；未配置时关联文件返回空列表，继续走 PWA。
# FRIDGEBOARD_ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...
# FRIDGEBOARD_IOS_TEAM_ID=ABCDE12345
FRIDGEBOARD_FLYCN_AUTHORIZE_URL=https://flycn.fyi/integrations/fridgeboard/authorize
# flycn 容器在同一 Docker 网络中的内部兑换地址，不应使用公网地址。
FRIDGEBOARD_FLYCN_EXCHANGE_URL=http://flycn-app:8000/api/internal/fridgeboard/token
# 与 flycn 的 FRIDGEBOARD_CLIENT_SECRET 一致，只能由部署环境注入。
FRIDGEBOARD_FLYCN_CLIENT_SECRET=replace-with-a-long-random-secret
# 私有 OpenWrt/LAN 部署可设置固定本地所有者 ID，跳过 flycn 登录。仅限受信任局域网，
# 且不要同时配置 flycn SSO 变量。
# FRIDGEBOARD_LOCAL_OWNER_USER_ID=local-household-owner
# Agnes 所有模型共用同一个 API token；只能由部署环境注入，禁止提交真实值。
FRIDGEBOARD_AGNES_RECOGNITION_URL=https://apihub.agnes-ai.com/v1/chat/completions
FRIDGEBOARD_AGNES_API_TOKEN=replace-with-agnes-api-token
FRIDGEBOARD_AGNES_MODEL=agnes-2.5-flash
# 识别/订单 JSON 输出上限；订单响应已收敛为五个必要字段，适配器限制在 256–8192。
FRIDGEBOARD_AGNES_MAX_TOKENS=8192
# Agnes OpenAI-compatible 推理强度；none 可避免思考占用结构化 JSON 输出预算。
FRIDGEBOARD_AGNES_REASONING_EFFORT=none
FRIDGEBOARD_AGNES_IMAGE_URL=https://apihub.agnes-ai.com/v1/images/generations
FRIDGEBOARD_AGNES_IMAGE_MODEL=agnes-image-2.1-flash
# 持久错误日志路径；生产按天轮换并保留当前文件及最近七个归档。
FRIDGEBOARD_LOG_FILE=/data/logs/fridgeboard.log
