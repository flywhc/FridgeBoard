{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "前端：Vite（7001）",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:7001",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "FridgeBoard：Vite",
      "postDebugTask": "FridgeBoard：停止前端"
    },
    {
      "name": "后端：FastAPI（7002）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "fridgeboard.main:app",
        "--app-dir",
        "backend",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "7002"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "FridgeBoard：数据库迁移",
      "console": "integratedTerminal",
      "justMyCode": true,
      "postDebugTask": "FridgeBoard：停止本地服务"
    }
  ],
  "compounds": [
    {
      "name": "F5：前后端联合调试",
      "configurations": [
        "前端：Vite（7001）",
        "后端：FastAPI（7002）"
      ],
      "stopAll": true
    }
  ]
}
